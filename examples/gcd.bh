# Greatest common divisor. The contract says what "gcd" means;
# the implementation (Euclid) is the AI's choice and can be swapped freely.

fn gcd(a: Int, b: Int) -> Nat
  examples
    gcd(12, 18)   => 6
    gcd(17, 5)    => 1
    gcd(0, 7)     => 7
    gcd(0, 0)     => 0
    gcd(-12, 18)  => 6
  property
    forall a, b: gcd(a, b) == gcd(b, a)
    forall a, b, k > 0: gcd(a * k, b * k) == k * gcd(a, b)
    forall a, b where gcd(a, b) > 0: a rem gcd(a, b) == 0 and b rem gcd(a, b) == 0
    forall a > 0, b > 0: no d > gcd(a, b) divides both a and b

implementation
  if b == 0
    abs(a)
  else
    gcd(b, a rem b)
  end
end
